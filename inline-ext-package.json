{
  "name": "jupyter-inline-completion",
  "version": "1.0.0",
  "description": "AI inline (ghost text) completion for JupyterLab using cache + ollama FIM",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "jlpm build:ts && jlpm build:labext",
    "build:ts": "tsc -b",
    "build:labext": "jupyter labextension build .",
    "install:labext": "jupyter labextension install --no-build ."
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyter_inline_completion/labextension",
    "discovery": {
      "server": {
        "managers": ["python"],
        "base": {
          "name": "jupyter_inline_completion"
        }
      }
    }
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/completer": "^4.0.0",
    "@jupyterlab/mainmenu": "^4.0.0",
    "@jupyterlab/settingregistry": "^4.0.0",
    "@lumino/coreutils": "^2.0.0"
  },
  "devDependencies": {
    "@jupyterlab/buildutils": "^4.0.0",
    "typescript": "~5.2.2"
  }
}
