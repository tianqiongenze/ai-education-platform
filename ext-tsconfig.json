{
  "compilerOptions": {
    "allowJs": true,
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "esModuleInterop": true,
    "declaration": true
  },
  "include": ["src/**/*"]
}
